---
// Cards for the folders inside a folder (subjects, subdomains, topics…), each with its lesson count.
import { allPages, plural, type Folder } from '@lib/content';
interface Props { folders: Folder[] }
const { folders } = Astro.props;
---
<ul class="cards" role="list">
  {folders.map((f) => {
    const n = allPages(f).length;
    return (
      <li data-accent={f.accent}>
        <a class="fc card" href={f.href}>
          {f.icon && <span class="icon" aria-hidden="true">{f.icon}</span>}
          <span class="name">{f.title}</span>
          {f.blurb && <span class="blurb">{f.blurb}</span>}
          <span class="meta">{n ? plural(n, 'lesson') : 'Coming soon'}{f.folders.length ? ` · ${plural(f.folders.length, 'part')}` : ''}</span>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); }
  .fc {
    position: relative; height: 100%; display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-5);
    text-decoration: none; color: var(--ink); border-radius: var(--radius-lg);
    background: radial-gradient(120% 90% at 100% 0%, var(--accent-soft), transparent 62%), var(--surface);
    transition: transform var(--fast) var(--ease), box-shadow var(--fast) var(--ease), border-color var(--fast);
  }
  .fc:hover { transform: translateY(-3px); box-shadow: var(--shadow-lift); border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  .icon {
    display: grid; place-items: center; width: 3.2rem; height: 3.2rem; font-size: 1.8rem; line-height: 1;
    border-radius: 16px; background: var(--surface); border: var(--border); box-shadow: var(--shadow);
    transition: transform 0.4s var(--ease-spring);
  }
  .fc:hover .icon { transform: rotate(-8deg) scale(1.06); }
  .name { font-family: var(--font-heading); font-size: var(--text-xl); font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; }
  .blurb { color: var(--ink-2); flex: 1; }
  .meta { margin-top: auto; font-weight: 700; color: var(--accent-ink); }
</style>
