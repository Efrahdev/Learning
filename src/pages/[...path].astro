---
/**
 * Every folder page and every lesson page, at any depth.
 * A folder lists its sub-folders and lessons; a lesson shows its words, or an older lesson in a frame.
 */
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LessonLayout from '../layouts/LessonLayout.astro';
import LegacyLayout from '../layouts/LegacyLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import LessonList from '@components/LessonList.astro';
import { lessonComponents } from '@components/mdx';
import { allFolders, allPages, ancestors, iconOf, getLibrary, plural, type Folder, type Page } from '@lib/content';

export async function getStaticPaths() {
  const root = await getLibrary();
  const folders = allFolders(root).filter((f) => f.depth > 0);
  return [
    ...folders.map((folder) => ({ params: { path: folder.path }, props: { kind: 'folder' as const, folder } })),
    ...allPages(root).map((page) => ({ params: { path: page.path }, props: { kind: 'page' as const, page } })),
  ];
}
type Props = { kind: 'folder'; folder: Folder } | { kind: 'page'; page: Page };
const props = Astro.props;
const Content = props.kind === 'page' && !props.page.data.legacy ? (await render(props.page.entry)).Content : null;
const folder = props.kind === 'folder' ? props.folder : null;
const count = folder ? allPages(folder).length : 0;
---
{props.kind === 'page' && props.page.data.legacy && <LegacyLayout page={props.page} />}
{props.kind === 'page' && Content && (
  <LessonLayout page={props.page}>
    <Content components={lessonComponents} />
  </LessonLayout>
)}
{folder && (
  <BaseLayout title={folder.title} description={folder.blurb} accent={folder.accent}>
    <Breadcrumb trail={ancestors(folder).map((f) => ({ label: f.title, href: f === folder ? undefined : f.href }))} />
    <header class="head">
      {iconOf(folder) && <span class="icon" aria-hidden="true" style={folder.depth === 1 ? `view-transition-name: icon-${folder.slug}` : undefined}>{iconOf(folder)}</span>}
      <h1 style={folder.depth === 1 ? `view-transition-name: title-${folder.slug}` : undefined}>{folder.title}</h1>
      {folder.blurb && <p class="lead">{folder.blurb}</p>}
      <p class="meta">{plural(count, 'lesson')}</p>
    </header>
    {folder.folders.length > 1 && (
      <nav class="topic-jump" aria-label="Topics in this subject">
        {folder.pages.length > 0 && <a href="#g-general">General <span>{folder.pages.length}</span></a>}
        {folder.folders.map((f) => <a href={`#g-${f.slug}`}>{f.title} <span>{allPages(f).length}</span></a>)}
      </nav>
    )}
    {/* Every lesson is listed right here, grouped by topic, so any lesson is one tap from its subject. */}
    {folder.pages.length > 0 && (
      <section class="lessons" id="g-general" aria-label="Lessons">
        {folder.folders.length > 0 && <h2>General</h2>}
        <LessonList pages={folder.pages} />
      </section>
    )}
    {folder.folders.map((f) => {
      const inside = allPages(f);
      return (
        <section class="lessons" id={`g-${f.slug}`} aria-labelledby={`h-${f.slug}`}>
          <h2 id={`h-${f.slug}`}><a href={f.href}>{f.title}</a> <span class="meta">{plural(inside.length, 'lesson')}</span></h2>
          {inside.length ? <LessonList pages={inside} /> : <p class="meta">Nothing here yet.</p>}
        </section>
      );
    })}
    {count === 0 && <p class="lead empty">Nothing here yet.</p>}
  </BaseLayout>
)}

<style>
  .head { display: flex; flex-direction: column; gap: var(--space-2); margin: var(--space-3) 0 var(--space-5); }
  .icon { font-size: 2.4rem; line-height: 1; width: fit-content; }
  @media (min-width: 48rem) { .icon { font-size: 3rem; } }
  h1 { width: fit-content; }
  h1 { font-size: clamp(var(--text-2xl), 1.4rem + 2.4vw, 3.2rem); font-weight: 800; letter-spacing: -0.03em; }
  .lessons { margin-top: var(--space-6); max-width: 48rem; scroll-margin-top: var(--space-4); }
  @media (min-width: 48rem) { .lessons { scroll-margin-top: 5.5rem; } }
  .lessons h2 { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2); font-size: var(--text-xl); margin-bottom: var(--space-3); }
  .lessons h2 a { color: var(--ink); text-decoration: none; }
  .lessons h2 a:hover { color: var(--accent-ink); text-decoration: underline; }
  .topic-jump { display: flex; gap: var(--space-2); overflow-x: auto; scrollbar-width: none; margin-inline: calc(-1 * var(--space-4)); padding: 2px var(--space-4); }
  .topic-jump::-webkit-scrollbar { display: none; }
  @media (min-width: 48rem) { .topic-jump { flex-wrap: wrap; overflow: visible; margin-inline: 0; padding-inline: 0; } }
  .topic-jump a {
    flex: 0 0 auto; display: inline-flex; align-items: center; gap: 6px; min-height: var(--tap); padding: 0 var(--space-3) 0 var(--space-4);
    border-radius: var(--radius-pill); border: 1px solid var(--line-2); background: var(--surface); color: var(--ink); font-weight: 700; text-decoration: none;
  }
  .topic-jump a:hover { border-color: var(--accent); background: var(--accent-soft); }
  .topic-jump span { font-size: 0.85rem; padding: 1px 7px; border-radius: var(--radius-pill); background: var(--accent-soft); color: var(--accent-ink); }
  .empty { margin-top: var(--space-4); }
</style>
