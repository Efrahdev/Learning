---
// The whole library on one page, as one tree you can filter. A React island (src/islands/Map.tsx).
import BaseLayout from '../layouts/BaseLayout.astro';
import LibraryMap from '@islands/Map';
import { getCatalogue } from '@lib/catalogue';
const data = await getCatalogue();
---
<BaseLayout title="Library map">
  <LibraryMap client:load data={data} />
</BaseLayout>
