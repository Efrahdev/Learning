---
// Instant search over every lesson (a React island). Full-text search inside lessons (Pagefind) can come in Phase 3.
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPage from '@islands/SearchPage';
import { getCatalogue } from '@lib/catalogue';
const data = await getCatalogue();
---
<BaseLayout title="Search">
  <SearchPage client:load data={data} />
</BaseLayout>

<style is:global>
  .search-page { display: flex; flex-direction: column; gap: var(--space-3); min-height: 60vh; }
  .search-page-title { font-size: clamp(var(--text-2xl), 1.4rem + 3vw, 3.6rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; }
  .search-page .search-wrap { margin-top: var(--space-3); }
</style>
