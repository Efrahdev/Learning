---
// Home: hero with instant search, subjects as a bento grid, and an explorer for every lesson.
// The page is one React island (src/islands/Home.tsx), rendered to HTML at build time and brought to life in the browser.
import BaseLayout from '../layouts/BaseLayout.astro';
import Home from '@islands/Home';
import { getCatalogue } from '@lib/catalogue';
import { url } from '@lib/url';
const data = await getCatalogue();
---
<BaseLayout title="Learning Library" home>
  <Home client:load data={data} mapHref={url('map/')} />
</BaseLayout>
