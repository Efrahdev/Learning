{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "public", "scripts"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@components/*": ["./src/components/*"],
      "@sims/*": ["./src/sims/*"],
      "@lib/*": ["./src/lib/*"],
      "@islands/*": ["./src/islands/*"]
    }
  }
}
